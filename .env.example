# Copy to .env and fill in. Docker Compose reads this automatically.

# Required: the passphrase that gates the dashboard.
# Generate one with: openssl rand -base64 24
REPOMAN_PASSPHRASE=

# Where your checkouts live on the host. Mounted read-write at /git.
REPO_ROOT=/home/you/git

# The host user that owns REPO_ROOT. Run `id -u` and `id -g`.
UID=1000
GID=1000

# Accounts whose full repo list is shown, so un-cloned repos appear as ghosts.
# Comma-separated; a bare name means github.com.
REPOMAN_OWNERS=github.com/jbain

# A GitHub personal access token. Read-only is enough to list repos and to
# clone private ones over https.
GH_TOKEN=

# Host port to publish on 127.0.0.1.
REPOMAN_PORT=8464

# Set false only if you are not terminating TLS in front of the service.
REPOMAN_SECURE_COOKIE=true
# Set false if nothing trustworthy sets X-Forwarded-For, otherwise a client
# can spoof the header and evade the login rate limiter.
REPOMAN_TRUST_PROXY_IP=true

REPOMAN_SCAN_INTERVAL=60s
REPOMAN_FETCH_INTERVAL=15m
REPOMAN_LOG_LEVEL=info
